{
  "name": "nextcampus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "./backend/.venv/bin/uvicorn backend.app.main:app --reload --host 127.0.0.1 --port 5000",
    "server:legacy": "nodemon server/index.js",
    "start": "./backend/.venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 5000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "PYTHONPATH=. ./backend/.venv/bin/pytest backend/tests -v && node tests/master_audit.test.js",
    "test:python": "PYTHONPATH=. ./backend/.venv/bin/pytest backend/tests -v"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.378.0",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.23.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0",
    "vite": "^5.2.11"
  }
}
